# dependencies
node_modules/

# Expo
.expo/
.expo-export-*/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# material bruto de clase (los PPTX del curso pesan cientos de MB).
# Los apuntes procesados viven en content/clases/*.md, que sí se versionan.
*.pptx
*Kurasu*.pdf
*.pptm

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
NossaClima/

# Archivos personales que quedan sueltos en la raíz (CVs, escaneos).
# No son parte del proyecto y no deben publicarse en un repo público.
RESUME_*.PDF
RESUME_*.pdf
