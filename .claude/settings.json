{
  "permissions": {
    "allow": [
      "Bash(npx tsc*)",
      "Bash(npx expo*)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(curl -s http://localhost*)",
      "Read", "Grep", "Glob"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
